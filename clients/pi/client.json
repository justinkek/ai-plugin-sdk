{
	"name": "Pi",
	"runs": {
		"hooks": true,
		"events": [
			"session_start",
			"prompt",
			"before_tool",
			"stop"
		],
		"tool_kinds": [
			"bash",
			"read",
			"write",
			"edit",
			"multi_edit",
			"grep",
			"glob",
			"list"
		],
		"done_through": {
			"delete": "bash",
			"move": "bash",
			"notebook_edit": "edit"
		},
		"skills": false,
		"settings": "install"
	},
	"note": "Skills load from ~/.agents/skills and an extension puts none there, so a plugin's skills do not arrive."
}
