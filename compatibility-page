#!/usr/bin/env bash

# Writes COMPATIBILITY.md: which clients this SDK supports, out of
# compatibility.json and the clients/ folder.
#
#   ai-plugin-sdk/compatibility-page [out]
#
# This is the SDK's own page and names no plugin. A plugin gets its own, from
# the build, which says what that plugin reaches rather than what the SDK has.

set -e

sdk="$(cd "$(dirname "$0")" && pwd)"
out="${1:-$sdk/COMPATIBILITY.md}"

. "$sdk/builder/compatibility.sh"

generated="Generated by ai-plugin-sdk/compatibility-page from compatibility.json. Run it rather than editing this."

named_client() { jq --raw-output '.name' "$sdk/clients/$1/client.json"; }

# One row per product and surface, in the order compatibility.json names them.
rows_for() {
  local vendor row client
  while read -r row; do
    client="$(printf '%s' "$row" | jq --raw-output '.client // empty')"
    if [ -z "$client" ] || [ ! -d "$sdk/clients/$client" ]; then
      printf '| %s | %s | %s | %s |\n' \
        "$(printf '%s' "$row" | jq --raw-output .product)" \
        "$(printf '%s' "$row" | jq --raw-output .surface)" \
        "$(printf '%s' "$row" | jq --raw-output .where)" \
        "$(printf '%s' "$row" | jq --raw-output '.says // "Not supported"')"
      continue
    fi
    if client_supports_everything "$client"; then said="Supported"; else said="Partial"; fi
    printf '| %s | %s | %s | %s |\n' \
      "$(printf '%s' "$row" | jq --raw-output .product)" \
      "$(printf '%s' "$row" | jq --raw-output .surface)" \
      "$(printf '%s' "$row" | jq --raw-output .where)" \
      "$said"
  done < <(jq --compact-output --arg v "$1" \
    '.vendors[] | select(.vendor == $v) | .products[]' "$sdk/compatibility.json")
}

# One line per client that runs less than everything, in the order the rows
# first name it.
notes() {
  local client shown="" note
  while read -r client; do
    [ -n "$client" ] || continue
    [ -d "$sdk/clients/$client" ] || continue
    case " $shown " in *" $client "*) continue ;; esac
    shown="$shown $client"
    client_supports_everything "$client" && continue
    note="$(client_runs "$client" .note)"
    [ -n "$note" ] || continue
    printf '%s\n' "- **$(named_client "$client")** - $note"
  done < <(jq --raw-output '.vendors[].products[].client // empty' "$sdk/compatibility.json")
}

{
  printf '# Where a plugin built with ai-plugin-sdk can be installed\n\n'
  printf '(audience: humans)\n\n'
  printf 'Supported means everything the SDK writes reaches a session: the hooks, the\n'
  printf 'skills and the settings. Partial means some of it does not, and the note\n'
  printf 'under the tables says which.\n\n'

  while read -r vendor; do
    printf '**%s**\n\n' "$vendor"
    printf '| Product | Surface | Where it runs | Support |\n'
    printf '| --- | --- | --- | --- |\n'
    rows_for "$vendor"
    printf '\n'
  done < <(jq --raw-output '.vendors[].vendor' "$sdk/compatibility.json")

  if [ -n "$(notes)" ]; then
    printf '**What is missing where it says Partial**\n\n'
    notes
    printf '\n'
  fi

  printf '## Note\n\n%s\n' "$generated"
} > "$out"
