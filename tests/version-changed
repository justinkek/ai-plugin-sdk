#!/usr/bin/env bash

# Every merge to main is a release: an install names no ref, so whatever the
# default branch points at is what a person gets. A merge that does not move
# the version leaves every skill, and every session asked which version it is
# running, naming something that is no longer what is running.
#
#   tests/version-changed <base-ref>
#
# Run by CI on a pull request. It is not in tests/run-tests, because a branch
# is allowed to be mid-change; it is the merge that has to carry the bump.

set -e

sdk="$(cd "$(dirname "$0")/.." && pwd)"
base="${1:-origin/main}"

version_in() { git -C "$sdk" show "$1:package.json" 2>/dev/null | jq --raw-output '.version // empty'; }

was="$(version_in "$base")"
now="$(jq --raw-output '.version' "$sdk/package.json")"

# The paths an install ever receives: whatever the build reads, plus the build
# and the file holding the version. A change to anything else - the README, the
# tests, the example plugin - reaches nobody, so it asks for no new version.
build_reads() {
  printf 'build\npackage.json\n'
  grep --recursive --only-matching --extended-regexp '\$sdk"?/[a-zA-Z.-]+' \
    "$sdk/build" "$sdk/builder" | sed -e 's/^[^:]*://' -e 's/\$sdk"\?\///' | sort --unique
}

changed_files() {
  git -C "$sdk" diff --name-only "$base...HEAD" 2>/dev/null \
    || git -C "$sdk" diff --name-only "$base" HEAD
}

# Whether this branch touches any of them.
touches_what_ships() {
  local path shipped
  while read -r path; do
    [ -n "$path" ] || continue
    while read -r shipped; do
      [ -n "$shipped" ] || continue
      case "$path" in "$shipped" | "$shipped"/*) return 0 ;; esac
    done <<SHIPPED
$(build_reads)
SHIPPED
  done <<CHANGED
$(changed_files)
CHANGED
  return 1
}

if [ -z "$was" ]; then
  printf 'no package.json on %s to compare against, so nothing to check\n' "$base"
  exit 0
fi

# A bump that goes backwards, or sideways into a typo, is a bump that names a
# version somebody already has.
newest() { printf '%s\n%s\n' "$1" "$2" | sort --version-sort | tail -1; }

if [ "$was" != "$now" ] && [ "$(newest "$was" "$now")" != "$now" ]; then
  printf 'the version went from %s back to %s.\n\n' "$was" "$now" >&2
  printf 'An install caches by version, so a number somebody already has is a\n' >&2
  printf 'number that reaches nobody. Raise it instead.\n' >&2
  exit 1
fi

if [ "$was" = "$now" ] && ! touches_what_ships; then
  printf 'the version is still %s, and nothing an install receives has changed.\n' "$now"
  exit 0
fi

if [ "$was" = "$now" ]; then
  printf 'the version is still %s.\n\n' "$now" >&2
  printf 'Every merge to main is a release here: an install names no ref, so what\n' >&2
  printf 'main points at is what a person gets. Raise the version in package.json,\n' >&2
  printf 'or this ships as a version that already means something else.\n\n' >&2
  printf 'Minor when a plugin built against %s would break on this one; patch\n' "$was" >&2
  printf 'when it would not. AGENTS.md has the rule.\n' >&2
  exit 1
fi

printf 'version %s -> %s\n' "$was" "$now"
