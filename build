#!/usr/bin/env bash

# Reads one plugin manifest and writes the folders an install copies from.
#
#   ai-plugin-sdk/build [plugin-directory] [out] [install-page]
#
# The plugin owns its manifest, its hooks, its skills and its client pages. The
# harnesses, the client steps and the hook libraries are the SDK's, and a plugin
# that wants one of its own puts a file of the same name beside its manifest.
#
# This file is the loop. builder/ holds the parts, one file to a subject.

set -e

sdk="$(cd "$(dirname "$0")" && pwd)"
plugin="$(cd "${1:-$PWD}" && pwd)"
out="${2:-$plugin/distributions}"
page="${3:-$plugin/INSTALL.md}"

. "$sdk/builder/manifest.sh"
. "$sdk/builder/harnesses.sh"
. "$sdk/builder/pages.sh"
. "$sdk/builder/skills.sh"
. "$sdk/builder/contents.sh"
. "$sdk/builder/compatibility.sh"

# One folder per harness this plugin names a client of.
distribution() {
  local harness="$1" target="$2" registered declared carried

  use_harness_root "$(harness_says "$harness" .root | filled '')"

  contents "$harness" "$target"

  # What tells this harness about the hooks, where that harness reads it.
  registered="$(harness_says "$harness" .registration)"
  case "$registered" in
    '' | none) ;;
    *) mkdir -p "$target/$(dirname "$registered")"
       registration "$harness" "$harness_root" > "$target/$registered" ;;
  esac

  # The manifest a marketplace reads, in the shape that harness reads it in.
  declared="$(harness_says "$harness" .manifest)"
  if [ -n "$declared" ]; then
    mkdir -p "$target/$(dirname "$declared")"
    jq --tab --from-file "$sdk/harnesses/$harness/manifest.jq" "$manifest" > "$target/$declared"
  fi

  # Whatever else that harness needs carried: an install script, an extension.
  while read -r carried; do
    [ -n "$carried" ] || continue
    mkdir -p "$target/$(dirname "$carried")"
    filled < "$sdk/harnesses/$harness/$carried" > "$target/$carried"
    case "$carried" in *.sh) chmod +x "$target/$carried" ;; esac
  done < <(cd "$sdk/harnesses/$harness" && find . -type f \
    ! -name harness.json ! -name manifest.jq | sed 's|^\./||')

  readme "$harness" "$target"
  mark_scripts "$target"
}

rm -rf "$out"

for harness in $(harnesses); do
  if builds_for "$harness"; then distribution "$harness" "$out/$harness"; fi
done

# A build that writes no folder at all has told the plugin nothing about why.
[ -d "$out" ] || {
  printf 'nothing was built for %s.\n\n' "$name" >&2
  printf 'No client could be reached. Check that plugin.json declares hooks or\n' >&2
  printf 'that the SDK has a client folder for what it names in `clients`.\n' >&2
  exit 1
}

install_page
compatibility_page "$plugin/COMPATIBILITY.md"
